# Адрес NATS (docker: -p 4222:4222)
SNT_NATS_URL=nats://127.0.0.1:4222

# Имя кластера — попадает в каждое событие (у aggregator'а может
# быть несколько watcher'ов с разных кластеров)
SNT_CLUSTER_NAME=kind-sentinel

# Namespace'ы, которые не мониторим: системные — это шум
SNT_IGNORE_NS=kube-system,kube-public,gmp-system,local-path-storage

# Путь к kubeconfig (пусто = стандартный ~/.kube/config)
SNT_KUBECONFIG=

SNT_MONGO_URL=mongodb://sentinel:sentinel@127.0.0.1:27017
SNT_MONGO_DB=sentinel

# Jira
SNT_JIRA_URL=https://url.atlassian.net
SNT_JIRA_EMAIL=mail@mail.ru
SNT_JIRA_TOKEN=token
SNT_JIRA_PROJECT=name
SNT_ALERT_THRESHOLD=5
SNT_ALERT_WINDOW=15m