# Адрес NATS (docker: -p 4222:4222)
SNT_NATS_URL=nats://127.0.0.1:4222

# Имя кластера — попадает в каждое событие (у aggregator'а может
# быть несколько watcher'ов с разных кластеров)
SNT_CLUSTER_NAME=kind-sentinel

# Namespace'ы, которые не мониторим: системные — это шум
SNT_IGNORE_NS=kube-system,kube-public,gmp-system

# Путь к kubeconfig (пусто = стандартный ~/.kube/config)
SNT_KUBECONFIG=
